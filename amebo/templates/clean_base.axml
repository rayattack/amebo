<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Amebo {{ ctx.amebo_version }}</title>

  <!-- Favicon -->
  <link rel="icon" href="/public/favicon.svg" type="image/svg+xml">

  <!-- Fonts & Icons -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined|Material+Icons" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- App Styles -->
  <link rel="stylesheet" href="/public/toastify.min.css" />
  <link rel="stylesheet" href="/public/amebo.css">

  <!-- Alpine.js + Plugins -->
  <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.x.x/dist/cdn.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/persist@3.x.x/dist/cdn.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- HTMX -->
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>

  <!-- Toastify -->
  <script src="/public/toastify.js"></script>

  {% from 'actions.axml' import scripts %}

  {% block head %}{% endblock %}
</head>

<body>
  <div class="app-layout" x-data="{
    showModal: false,
    darkMode: $persist(false),
    sidebarExpanded: $persist(false),
    init() {
      this.$watch('darkMode', val => {
        document.documentElement.setAttribute('data-bs-theme', val ? 'dark' : 'light');
      });
      document.documentElement.setAttribute('data-bs-theme', this.darkMode ? 'dark' : 'light');

      // Initialize Bootstrap tooltips
      this.$nextTick(() => {
        this.refreshTooltips();
      });
    },
    refreshTooltips() {
      // Dispose existing tooltips
      document.querySelectorAll('[data-bs-toggle=tooltip]').forEach(el => {
        const existing = bootstrap.Tooltip.getInstance(el);
        if (existing) existing.dispose();
      });
      // Only enable tooltips when sidebar is collapsed
      if (!this.sidebarExpanded) {
        document.querySelectorAll('[data-bs-toggle=tooltip]').forEach(el => {
          new bootstrap.Tooltip(el, { placement: 'right', trigger: 'hover' });
        });
      }
    }
  }">

    <!-- Sidebar -->
    <aside class="app-sidebar" :class="sidebarExpanded ? 'expanded' : ''" id="appSidebar">
      <div class="sidebar-brand">
        <span class="material-icons brand-icon">dns</span>
        <template x-if="sidebarExpanded">
          <span class="d-flex align-items-center gap-2 overflow-hidden">
            <span class="brand-text">Amebo</span>
            <span class="brand-version">{{ ctx.amebo_version }}</span>
          </span>
        </template>
      </div>

      <nav class="sidebar-nav">
        {% set navs = [
          ('dashboard', 'monitoring', 'Dashboard'),
          ('applications', 'layers', 'Applications'),
          ('actions', 'bolt', 'Actions'),
          ('events', 'notifications_active', 'Events'),
          ('subscriptions', 'rss_feed', 'Subscriptions'),
          ('gists', 'send', 'Gists'),
          ('redactions', 'visibility_off', 'Redactions')
        ] %}

        {% for endpoint, icon, label in navs %}
        <a href="/p/{{ endpoint }}"
          class="nav-link {{ 'active' if req.url[3:] == endpoint else '' }}"
          data-bs-toggle="tooltip" data-bs-title="{{ label }}">
          <span class="material-icons nav-icon">{{ icon }}</span>
          <span class="nav-label" x-show="sidebarExpanded" x-cloak>{{ label }}</span>
        </a>
        {% endfor %}
      </nav>

      <div class="sidebar-footer">
        <!-- Theme toggle -->
        <button type="button" class="nav-link theme-toggle"
          @click="darkMode = !darkMode"
          data-bs-toggle="tooltip"
          :data-bs-title="darkMode ? 'Light Mode' : 'Dark Mode'">
          <span class="material-icons nav-icon" x-text="darkMode ? 'light_mode' : 'dark_mode'"></span>
          <span class="nav-label" x-show="sidebarExpanded" x-cloak
            x-text="darkMode ? 'Light Mode' : 'Dark Mode'"></span>
        </button>

        <!-- Expand/Collapse toggle -->
        <button type="button" class="nav-link sidebar-toggle"
          @click="sidebarExpanded = !sidebarExpanded; $nextTick(() => refreshTooltips())"
          data-bs-toggle="tooltip"
          :data-bs-title="sidebarExpanded ? 'Collapse sidebar' : 'Expand sidebar'">
          <span class="material-icons nav-icon"
            x-text="sidebarExpanded ? 'menu_open' : 'menu'"></span>
          <span class="nav-label" x-show="sidebarExpanded" x-cloak>Collapse</span>
        </button>

        <!-- New Resource button -->
        <button type="button" class="btn btn-dark w-100 btn-sm new-resource-btn"
          @click="showModal = true"
          data-bs-toggle="tooltip" data-bs-title="New Resource">
          <span class="material-icons" style="font-size: 18px;">add</span>
          <span class="btn-label" x-show="sidebarExpanded" x-cloak>New Resource</span>
        </button>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="app-main" style="padding: 0;">
      {% macro controller(target) %}
      {
        {{target}}: [],
        previewing: false,
        pagination: 15,
        page: 1,
        totalShown: 0,
        isPaginating: false,
        isFiltering: false,
        loading: false,

        fetchAll() {
          this.loading = true;
          fetch(`/v1/{{target}}?pagination=${this.pagination}&page=${this.page}`)
            .then(r => r.json())
            .then(data => {
              this.{{target}} = data;
              this.totalShown = data.length;
              this.loading = false;
            })
            .catch(err => {
              ShowFeedback('error', 'Failed to fetch {{target}}');
              this.loading = false;
            })
        },

        pageDown() {
          if (this.page <= 1) return;
          this.page -= 1;
          this.fetchAll();
        },

        pageUp() {
          this.page += 1;
          this.fetchAll();
        },

        refreshPage() {
          fetch(`/v1/{{target}}?pagination=${this.pagination}&page=${this.page}`)
            .then(r => r.json())
            .then(data => {
              this.{{target}} = data;
              this.totalShown = data.length;
            })
            .catch(err => ShowFeedback('error', 'Refresh failed'))
        },

        schemafy(schema) {
          return JSON.stringify(schema, undefined, 2);
        },

        truncate(text, max) {
          if (!text) return '';
          return text.length > max ? text.slice(0, max) + '...' : text;
        }
      }
      {% endmacro %}

      {% block easel %}{% endblock %}
    </main>

    <!-- Modal -->
    <div class="modal fade" :class="showModal ? 'show d-block' : ''" tabindex="-1"
      style="background: rgba(0,0,0,0.4);" x-show="showModal" x-transition.opacity>
      <div class="modal-dialog modal-dialog-centered" style="max-width: 560px;">
        <div class="modal-content border-0 shadow-lg">
          <div class="modal-header border-bottom-0 pb-0">
            <h5 class="modal-title fw-bold">{{ modal_name }}</h5>
            <button type="button" class="btn-close" @click="showModal = false"></button>
          </div>
          {% block wizard %}{% endblock %}
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  {{ scripts() }}
  {% include 'scripts.axml' %}
  {% include 'functions.axml' %}
</body>

</html>

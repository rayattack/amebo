
{% macro scripts() %}
<script>
    const FeedbackColors = {
        'error': 'linear-gradient(135deg, #ff6b6b, #ee5a24)',
        'success': 'linear-gradient(135deg, #51cf66, #20c997)',
        'warning': 'linear-gradient(135deg, #fcc419, #fab005)',
        'info': 'linear-gradient(135deg, #4dabf7, #228be6)',
    }
    const ShowFeedback = (type, text, dur, handler, closable) => {
        const background = FeedbackColors[type] || FeedbackColors['info'];
        const duration = dur || 3000;
        const close = closable || false;
        const onClick = handler || (() => {});

        Toastify({
            text,
            duration,
            style: { background, borderRadius: '8px', fontFamily: 'Inter, sans-serif', fontSize: '13px', padding: '10px 16px' },
            onClick,
            close,
            gravity: 'top',
            position: 'right'
        }).showToast();
    }

    const xrequest = (url, data, vm) => {
        const _helper = (method, nodata) => {
            const base = superagent[method](url)
                .set('content-type', 'application/json')
            if(nodata){
                let viewmodel = data || 'webclient';
                return base.set('X-Requested-With', viewmodel);
            }
            else {
                let viewmodel = vm || 'webclient';
                return base.set('X-Requested-With', viewmodel).send(JSON.stringify(data))
            }
        }
        return {
            post: _helper('post'),
            get: _helper('get', true),
            put: _helper('put'),
            delete: _helper('delete'),
            patch: _helper('patch')
        }
    }
</script>
{% endmacro %}


{% macro pagination() %}
<div class="pagination-bar">
    <div class="d-flex align-items-center gap-2">
        <button class="btn-icon" @click="pageDown" :disabled="isFiltering || page <= 1"
            title="Previous page">
            <span class="material-icons" style="font-size: 18px;">chevron_left</span>
        </button>

        <input class="page-input" type="text"
            x-model.number="page"
            @keyup.enter="fetchAll()"
            :disabled="isFiltering">

        <button class="btn-icon" @click="pageUp" :disabled="isFiltering"
            title="Next page">
            <span class="material-icons" style="font-size: 18px;">chevron_right</span>
        </button>

        <button class="btn btn-sm btn-outline-secondary" @click="fetchAll()" :disabled="isFiltering"
            style="font-size: 0.75rem; height: 32px;">
            Go
        </button>

        <span class="text-sm ms-1" x-show="!isFiltering"
            x-text="`Page ${page}`"></span>
        <span class="text-sm ms-1" x-show="isFiltering">Filtered</span>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="text-sm">Rows:</span>
        <select class="rows-select" x-model.number="pagination" x-effect="refreshPage()" :disabled="isFiltering">
            <template x-for="count in [15, 25, 50, 100]">
                <option :value="count" x-text="count"></option>
            </template>
        </select>
    </div>
</div>
{% endmacro %}
